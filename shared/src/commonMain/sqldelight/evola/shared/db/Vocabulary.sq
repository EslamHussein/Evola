CREATE TABLE vocabulary_items (
    id TEXT NOT NULL PRIMARY KEY,
    lesson_id TEXT NOT NULL,
    term TEXT NOT NULL,
    meaning TEXT NOT NULL,
    gender TEXT,
    example_sentence TEXT,
    part_of_speech TEXT,
    grammatical_case TEXT,
    example_sentence_translation TEXT,
    meaning_ar TEXT,
    ipa_pronunciation TEXT,
    related_words TEXT,
    difficulty_rating TEXT,
    frequency_rating TEXT,
    memory_tip TEXT,
    grammar_note TEXT,
    created_at INTEGER NOT NULL
);

-- Lingvist-style flat-queue engine (replaces the retired pack/7-stage model). status is one of
-- unseen|introduced|learning|review|mastered (evola.shared.vocabulary.VocabularySrs.STATUSES).
CREATE TABLE vocabulary_progress (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    vocabulary_item_id TEXT NOT NULL,
    status TEXT NOT NULL,
    correct_streak INTEGER NOT NULL,
    incorrect_streak INTEGER NOT NULL,
    interval_index INTEGER NOT NULL,
    next_review_at INTEGER NOT NULL,
    last_seen_at INTEGER,
    is_bookmarked INTEGER NOT NULL,
    marked_difficult INTEGER NOT NULL
);

CREATE INDEX vocabulary_progress_due_idx ON vocabulary_progress(user_id, next_review_at);

-- One row per study session for a lesson. Composition stats feed the summary screen directly -
-- no need to recompute from the queue at complete() time beyond the distinct-word count.
CREATE TABLE vocabulary_sessions (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    lesson_id TEXT NOT NULL,
    session_number INTEGER NOT NULL,
    started_at INTEGER NOT NULL,
    completed_at INTEGER,
    new_words_count INTEGER NOT NULL,
    review_words_count INTEGER NOT NULL,
    correct_count INTEGER NOT NULL,
    incorrect_count INTEGER NOT NULL
);

-- Persisted ordered queue: one row per card the session will show (or has shown). "Current card" is
-- the first unanswered row by position - the same live-recompute-from-data convention the retired
-- pack model used for its own current-position lookup, so exiting mid-card is always safe and
-- resuming lands exactly where the user left off. card_type is one of intro|recognition|wordbank|
-- hint|blind (evola.shared.vocabulary.VocabularyCard) - a new word's ladder (recognition->wordbank->
-- hint->blind) is spliced in one step at a time (never pre-inserted) as each step is answered
-- correctly, at `answeredPosition + 1` (well inside the 100-wide gap left between initially-inserted
-- rows). A wrong answer at any graded step appends one row of the SAME card_type at
-- `maxQueuePosition + 100`, origin='repeat' - simply past every existing row, so it reappears later
-- in the session without ever needing to shift other rows. choices (JSON-encoded, nullable) holds
-- the shuffled option set for recognition/wordbank rows, persisted so a resumed session shows the
-- identical choices rather than a reshuffle.
CREATE TABLE vocabulary_session_queue (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    vocabulary_item_id TEXT NOT NULL,
    card_type TEXT NOT NULL,
    origin TEXT NOT NULL,
    choices TEXT,
    answered_at INTEGER,
    correct INTEGER,
    user_response TEXT
);

-- items -----------------------------------------------------------------

itemsByLesson:
SELECT * FROM vocabulary_items WHERE lesson_id = ? ORDER BY created_at ASC;

insertItem:
INSERT INTO vocabulary_items(id, lesson_id, term, meaning, gender, example_sentence, part_of_speech, grammatical_case, example_sentence_translation, meaning_ar, ipa_pronunciation, related_words, difficulty_rating, frequency_rating, memory_tip, grammar_note, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

itemById:
SELECT * FROM vocabulary_items WHERE id = ?;

updateItemContent:
UPDATE vocabulary_items SET term = ?, meaning = ?, meaning_ar = ? WHERE id = ?;

-- progress ----------------------------------------------------------------

progressForItem:
SELECT * FROM vocabulary_progress WHERE user_id = ? AND vocabulary_item_id = ?;

insertProgress:
INSERT INTO vocabulary_progress(id, user_id, vocabulary_item_id, status, correct_streak, incorrect_streak, interval_index, next_review_at, last_seen_at, is_bookmarked, marked_difficult)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProgress:
UPDATE vocabulary_progress SET status = ?, correct_streak = ?, incorrect_streak = ?, interval_index = ?, next_review_at = ?, last_seen_at = ?
WHERE user_id = ? AND vocabulary_item_id = ?;

setBookmarked:
UPDATE vocabulary_progress SET is_bookmarked = ? WHERE user_id = ? AND vocabulary_item_id = ?;

setMarkedDifficult:
UPDATE vocabulary_progress SET marked_difficult = ? WHERE user_id = ? AND vocabulary_item_id = ?;

-- item + this user's progress, one row per lesson item (listVocabulary / updateFlags read).
itemsWithProgressByLesson:
SELECT vi.*, vp.status AS p_status, vp.is_bookmarked AS p_is_bookmarked, vp.marked_difficult AS p_marked_difficult
FROM vocabulary_items vi
JOIN vocabulary_progress vp ON vi.id = vp.vocabulary_item_id
WHERE vi.lesson_id = ? AND vp.user_id = ?
ORDER BY vi.created_at ASC;

itemWithProgress:
SELECT vi.*, vp.status AS p_status, vp.is_bookmarked AS p_is_bookmarked, vp.marked_difficult AS p_marked_difficult
FROM vocabulary_items vi
JOIN vocabulary_progress vp ON vi.id = vp.vocabulary_item_id
WHERE vi.id = ? AND vp.user_id = ?;

-- Partial-credit progress, Lingvist-engine version: per lesson item, current status (unseen if no
-- progress row yet). LocalProgress.lessonVocabProgress maps each status through
-- VocabularySrs.STATUSES.indexOf(status) / (STATUSES.size - 1f) and averages - the same shape
-- LocalProgress.lessonGrammarProgress already uses against MasterySrs.STAGES.
statusByLesson:
SELECT vi.id AS item_id, COALESCE(vp.status, 'unseen') AS status
FROM vocabulary_items vi
LEFT JOIN vocabulary_progress vp ON vp.vocabulary_item_id = vi.id AND vp.user_id = ?
WHERE vi.lesson_id = ?;

-- Every word's current status across every lesson in a goal, for the Home dashboard's
-- not-started/in-progress/mastered breakdown (bucketed in Kotlin against VocabularySrs.STATUSES).
wordStatusesByGoal:
SELECT vi.id AS item_id, COALESCE(vp.status, 'unseen') AS status
FROM vocabulary_items vi
JOIN lessons l ON l.id = vi.lesson_id
LEFT JOIN vocabulary_progress vp ON vp.vocabulary_item_id = vi.id AND vp.user_id = ?
WHERE l.goal_id = ?;

-- Session queue assembly draws --------------------------------------------

newItemsForLesson:
SELECT vi.id FROM vocabulary_items vi
LEFT JOIN vocabulary_progress vp ON vp.vocabulary_item_id = vi.id AND vp.user_id = ?
WHERE vi.lesson_id = ? AND (vp.id IS NULL OR vp.status = 'unseen')
ORDER BY vi.created_at ASC LIMIT ?;

dueItemsInLesson:
SELECT vi.id FROM vocabulary_items vi
JOIN vocabulary_progress vp ON vi.id = vp.vocabulary_item_id
WHERE vi.lesson_id = ? AND vp.user_id = ? AND vp.status NOT IN ('unseen', 'introduced') AND vp.next_review_at <= ?
ORDER BY vp.next_review_at ASC LIMIT ?;

dueItemsElsewhere:
SELECT vi.id FROM vocabulary_items vi
JOIN vocabulary_progress vp ON vi.id = vp.vocabulary_item_id
WHERE vi.lesson_id != ? AND vp.user_id = ? AND vp.status NOT IN ('unseen', 'introduced') AND vp.next_review_at <= ?
ORDER BY vp.next_review_at ASC LIMIT ?;

masteredItems:
SELECT vi.id FROM vocabulary_items vi
JOIN vocabulary_progress vp ON vi.id = vp.vocabulary_item_id
WHERE vp.user_id = ? AND vp.status = 'mastered'
LIMIT ?;

allUserVocab:
SELECT vi.id, vi.term, vi.meaning, vi.meaning_ar, vi.example_sentence, vi.example_sentence_translation
FROM vocabulary_items vi
JOIN vocabulary_progress vp ON vi.id = vp.vocabulary_item_id
WHERE vp.user_id = ?;

-- Sessions -----------------------------------------------------------------

incompleteSessionForLesson:
SELECT * FROM vocabulary_sessions WHERE user_id = ? AND lesson_id = ? AND completed_at IS NULL LIMIT 1;

sessionById:
SELECT * FROM vocabulary_sessions WHERE id = ? AND user_id = ?;

maxSessionNumber:
SELECT session_number FROM vocabulary_sessions WHERE user_id = ? AND lesson_id = ? ORDER BY session_number DESC LIMIT 1;

insertSession:
INSERT INTO vocabulary_sessions(id, user_id, lesson_id, session_number, started_at, completed_at, new_words_count, review_words_count, correct_count, incorrect_count)
VALUES (?, ?, ?, ?, ?, NULL, ?, ?, 0, 0);

incrementSessionCounters:
UPDATE vocabulary_sessions SET correct_count = correct_count + ?, incorrect_count = incorrect_count + ? WHERE id = ?;

completeSession:
UPDATE vocabulary_sessions SET completed_at = ? WHERE id = ?;

-- Queue ---------------------------------------------------------------------

queueForSession:
SELECT * FROM vocabulary_session_queue WHERE session_id = ? ORDER BY position ASC;

nextQueueItem:
SELECT * FROM vocabulary_session_queue WHERE session_id = ? AND answered_at IS NULL ORDER BY position ASC LIMIT 1;

maxQueuePosition:
SELECT MAX(position) FROM vocabulary_session_queue WHERE session_id = ?;

insertQueueItem:
INSERT INTO vocabulary_session_queue(id, session_id, position, vocabulary_item_id, card_type, origin, choices, answered_at, correct, user_response)
VALUES (?, ?, ?, ?, ?, ?, ?, NULL, NULL, NULL);

answerQueueItem:
UPDATE vocabulary_session_queue SET answered_at = ?, correct = ?, user_response = ? WHERE id = ?;

wordsPracticedInSession:
SELECT COUNT(DISTINCT vocabulary_item_id) FROM vocabulary_session_queue WHERE session_id = ?;
