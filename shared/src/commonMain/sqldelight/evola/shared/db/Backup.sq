-- Full-fidelity dump/restore queries for BackupRepository - deliberately separate from every
-- table's own business `insert` query (those default several columns and aren't meant to
-- round-trip a row exactly). Scope: goals, materials, lessons, vocabulary_items, vocabulary_progress,
-- daily_activity, user_settings - the data a learner would actually mourn losing. Grammar tables and
-- in-progress session/queue state are deliberately excluded (regenerable/re-derivable, not source
-- data), keeping this file's surface area proportionate.

selectAllGoals:
SELECT * FROM goals WHERE user_id = ?;

selectAllMaterials:
SELECT * FROM materials WHERE user_id = ?;

selectAllLessons:
SELECT lessons.* FROM lessons JOIN materials ON materials.id = lessons.material_id WHERE materials.user_id = ?;

selectAllVocabularyItems:
SELECT vocabulary_items.* FROM vocabulary_items
JOIN lessons ON lessons.id = vocabulary_items.lesson_id
JOIN materials ON materials.id = lessons.material_id
WHERE materials.user_id = ?;

selectAllVocabularyProgress:
SELECT * FROM vocabulary_progress WHERE user_id = ?;

selectAllDailyActivity:
SELECT * FROM daily_activity WHERE user_id = ?;

selectAllUserSettings:
SELECT * FROM user_settings WHERE user_id = ?;

-- Deleted in explicit dependency order (progress -> items -> lessons -> materials -> goals) rather
-- than relying on ON DELETE CASCADE firing - this repository shouldn't assume the driver's foreign-
-- key enforcement is on (SQLite requires it per-connection, and the in-memory JDBC driver used by
-- tests doesn't enable it by default).
deleteAllGoals:
DELETE FROM goals WHERE user_id = ?;

deleteAllMaterials:
DELETE FROM materials WHERE user_id = ?;

deleteAllLessonsForUser:
DELETE FROM lessons WHERE material_id IN (SELECT id FROM materials WHERE user_id = ?);

deleteAllVocabularyItemsForUser:
DELETE FROM vocabulary_items WHERE lesson_id IN (
    SELECT lessons.id FROM lessons JOIN materials ON materials.id = lessons.material_id WHERE materials.user_id = ?
);

deleteAllVocabularyProgress:
DELETE FROM vocabulary_progress WHERE user_id = ?;

deleteAllDailyActivity:
DELETE FROM daily_activity WHERE user_id = ?;

deleteAllUserSettings:
DELETE FROM user_settings WHERE user_id = ?;

restoreGoal:
INSERT INTO goals(id, user_id, goal_text, title, native_language, is_active, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

restoreMaterial:
INSERT INTO materials(id, user_id, goal_id, filename, content_hash, status, mime_type, size_bytes, page_count, organization_mode, ai_instructions, resource_type, content_text, input_tokens, output_tokens, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

restoreLesson:
INSERT INTO lessons(id, material_id, goal_id, number, title, status, origin_kind, source_label, source_text_ref, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

restoreVocabularyItem:
INSERT INTO vocabulary_items(id, lesson_id, term, meaning, gender, example_sentence, part_of_speech, plural, grammatical_case, example_sentence_translation, native_meaning, ipa_pronunciation, related_words, difficulty_rating, frequency_rating, memory_tip, grammar_note, ai_note, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

restoreVocabularyProgress:
INSERT INTO vocabulary_progress(id, user_id, vocabulary_item_id, status, correct_streak, incorrect_streak, interval_index, next_review_at, last_seen_at, is_bookmarked, marked_difficult)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

restoreDailyActivity:
INSERT INTO daily_activity(id, user_id, activity_date, completed) VALUES (?, ?, ?, ?);

restoreUserSetting:
INSERT INTO user_settings(user_id, key, value) VALUES (?, ?, ?);
