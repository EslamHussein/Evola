CREATE TABLE daily_activity (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    activity_date TEXT NOT NULL,
    completed INTEGER NOT NULL,
    UNIQUE (user_id, activity_date)
);

completedDates:
SELECT activity_date FROM daily_activity WHERE user_id = ? AND completed = 1;

forDate:
SELECT * FROM daily_activity WHERE user_id = ? AND activity_date = ?;

-- INSERT OR REPLACE (not ON CONFLICT DO UPDATE, unsupported on older Android SQLite) - we only ever
-- write completed = 1, so a replace on the (user_id, activity_date) unique key is equivalent.
upsert:
INSERT OR REPLACE INTO daily_activity(id, user_id, activity_date, completed)
VALUES (?, ?, ?, 1);

-- Reword's "Streak freeze" - a bridged date is treated as if it had real activity for streak-
-- continuity purposes only (never counted toward a real day's new/review word totals). Append-only,
-- tiny (bounded by however many freezes the user is ever granted).
CREATE TABLE streak_freeze_dates (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    freeze_date TEXT NOT NULL,
    UNIQUE (user_id, freeze_date)
);

frozenDates:
SELECT freeze_date FROM streak_freeze_dates WHERE user_id = ?;

insertFreeze:
INSERT OR IGNORE INTO streak_freeze_dates(id, user_id, freeze_date) VALUES (?, ?, ?);

-- extraction pipeline scratch (content-hash keyed, not user-scoped) - kept for the on-device
-- segmentation port; no cross-user cache semantics remain on a single device.
CREATE TABLE extraction_jobs (
    id TEXT NOT NULL PRIMARY KEY,
    content_hash TEXT NOT NULL UNIQUE,
    status TEXT NOT NULL,
    error TEXT,
    content_text TEXT NOT NULL,
    failed_ranges TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);
