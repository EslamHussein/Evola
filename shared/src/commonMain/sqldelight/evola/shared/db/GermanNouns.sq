-- One-time local copy of the bundled German noun dataset (gambolputty/german-nouns, CC-BY-SA-4.0 -
-- attribution in Profile's Credits section). Populated once by GermanNounImporter from the
-- composeResources CSV asset, so every later app launch queries this table directly instead of
-- re-parsing a 20MB file every time. raw_row keeps the full original CSV row (all case/number
-- flexion columns) for future use, even though only lemma/part_of_speech/genus/nominativ_plural
-- are indexed/queried today.
CREATE TABLE german_nouns (
    lemma TEXT NOT NULL,
    part_of_speech TEXT NOT NULL,
    genus TEXT,
    nominativ_plural TEXT,
    raw_row TEXT NOT NULL
);

CREATE INDEX german_nouns_lemma_idx ON german_nouns(lemma);

countNouns:
SELECT COUNT(*) FROM german_nouns;

insertNoun:
INSERT INTO german_nouns(lemma, part_of_speech, genus, nominativ_plural, raw_row)
VALUES (?, ?, ?, ?, ?);

lookupNoun:
SELECT * FROM german_nouns WHERE lemma = ? COLLATE NOCASE LIMIT 1;
