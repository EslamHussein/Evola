-- origin_kind distinguishes an authored curriculum lesson from a document-derived section
-- (draft = unreviewed, reviewed = user-confirmed - no review UI yet, just the states) - unrelated
-- to `status`, which tracks AI-extraction progress (pending/extracting/ready/failed) for either
-- kind. DEFAULT 'curriculum' means every existing insert() call site (today's only lesson-creation
-- path) keeps working unchanged and every row it creates is correctly backfilled as curriculum,
-- since none of them list this column explicitly. source_label is the document pipeline's
-- human-readable section origin (e.g. "Page 3") - null for curriculum lessons.
CREATE TABLE lessons (
    id TEXT NOT NULL PRIMARY KEY,
    material_id TEXT NOT NULL REFERENCES materials(id) ON DELETE CASCADE,
    goal_id TEXT NOT NULL,
    number INTEGER NOT NULL,
    title TEXT NOT NULL,
    status TEXT NOT NULL,
    origin_kind TEXT NOT NULL DEFAULT 'curriculum',
    source_label TEXT,
    source_text_ref TEXT,
    created_at INTEGER NOT NULL
);

-- Existing rows are all authored curriculum lessons - anything created before document-derived
-- sections exist should never be silently reinterpreted as something else. New lesson-scoped
-- listing/counting queries below join through this instead of filtering vocabulary_items.lesson_id
-- directly, mirroring the lesson_vocabulary view pattern in Vocabulary.sq. Deliberately NOT every
-- query that touches `lessons` is repointed here - selectById/selectByMaterial/countByMaterial/
-- countReadyByMaterial stay on the base table because they're shared with processMaterial's own
-- bookkeeping (which must see draft/reviewed sections to process them, once the document pipeline
-- exists) - only the genuine "list everything for this goal" call sites are curriculum-only.
CREATE VIEW curriculum_lessons AS
SELECT * FROM lessons WHERE origin_kind = 'curriculum';

insert:
INSERT INTO lessons(id, material_id, goal_id, number, title, status, source_text_ref, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- For the (not yet built) document pipeline - explicit origin_kind/source_label rather than
-- relying on insert()'s curriculum default.
insertSection:
INSERT INTO lessons(id, material_id, goal_id, number, title, status, origin_kind, source_label, source_text_ref, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM lessons WHERE id = ?;

selectByMaterial:
SELECT * FROM lessons WHERE material_id = ? ORDER BY number ASC;

selectByGoal:
SELECT * FROM curriculum_lessons WHERE goal_id = ? ORDER BY created_at ASC, number ASC;

-- Document-derived lessons for a material, for the Option B re-parenting check in
-- LocalMaterialsRepository.deleteMaterial - see Vocabulary.sq's originatingItemsForLesson /
-- survivingCurriculumLinkForItem / reassignItemOrigin.
documentDerivedLessonIdsForMaterial:
SELECT id FROM lessons WHERE material_id = ? AND origin_kind != 'curriculum';

updateStatus:
UPDATE lessons SET status = ? WHERE id = ?;

deleteById:
DELETE FROM lessons WHERE id = ?;

sweepStuckExtracting:
UPDATE lessons SET status = 'failed' WHERE material_id = ? AND status = 'extracting';

countByMaterial:
SELECT COUNT(*) FROM lessons WHERE material_id = ?;

countReadyByMaterial:
SELECT COUNT(*) FROM lessons WHERE material_id = ? AND status = 'ready';
