CREATE TABLE materials (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    goal_id TEXT NOT NULL,
    filename TEXT NOT NULL,
    content_hash TEXT NOT NULL,
    status TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    page_count INTEGER,
    organization_mode TEXT NOT NULL,
    ai_instructions TEXT,
    resource_type TEXT,
    content_text TEXT,
    created_at INTEGER NOT NULL
);

insert:
INSERT INTO materials(id, user_id, goal_id, filename, content_hash, status, mime_type, size_bytes, page_count, organization_mode, ai_instructions, resource_type, content_text, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM materials WHERE id = ?;

selectByUser:
SELECT * FROM materials WHERE user_id = ? ORDER BY created_at DESC;

selectByContentHash:
SELECT * FROM materials WHERE user_id = ? AND content_hash = ?;

updateStatus:
UPDATE materials SET status = ? WHERE id = ?;
